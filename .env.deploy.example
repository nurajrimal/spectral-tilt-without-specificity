# SSH Connection Details
HOST=123.45.67.89
PORT=2222
KEY=path/to/your/private_key
USER=root

# Remote configuration
REMOTE_DIR=/root/linear_rep_geometry

# Hugging Face token (required for gated models like Llama)
HF_TOKEN=hf_your_token_here

# === ALL 22 MODELS (single list — pipeline runs sequentially, smallest→largest) ===
# Dense: Qwen2.5 (0.5B→32B), Qwen3 (0.6B→8B), Gemma-2, Llama-3.2, Mistral, SmolLM2
# MoE:   OLMoE, DeepSeek-V2-Lite, DeepSeek-MoE-16B, JetMoE, Qwen3-30B-A3B
#
# Pipeline auto-skips models with existing results (set FORCE_RERUN=1 to override).
# OOM errors are caught and logged — pipeline continues to next model automatically.

MODEL_LIST="Qwen/Qwen2.5-0.5B,Qwen/Qwen2.5-1.5B,Qwen/Qwen2.5-3B,Qwen/Qwen3-0.6B,Qwen/Qwen3-1.7B,Qwen/Qwen3-4B,HuggingFaceTB/SmolLM2-1.7B,google/gemma-2-2b,meta-llama/Llama-3.2-1B,meta-llama/Llama-3.2-3B,allenai/OLMoE-1B-7B-0125,jetmoe/jetmoe-8b,Qwen/Qwen2.5-7B,Qwen/Qwen3-8B,google/gemma-2-9b,mistralai/Mistral-7B-v0.3,deepseek-ai/DeepSeek-V2-Lite,deepseek-ai/deepseek-moe-16b-base,Qwen/Qwen2.5-14B,google/gemma-2-27b,Qwen/Qwen2.5-32B,Qwen/Qwen3-30B-A3B"
